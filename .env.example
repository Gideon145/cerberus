# Somnia RPC (testnet = 50312, mainnet = 5031)
SOMNIA_RPC=https://testnet.somnia.network/rpc

# Agent wallet private key (needs SOMI/STT for gas)
AGENT_PRIVATE_KEY=0x...

# Deployed CerberusSentinel contract address
SENTINEL_ADDRESS=0x...

# Comma-separated list of contracts to protect
PROTECTED_CONTRACTS=0x...

# Optional: agent scan interval in ms (default: 60000)
INTERVAL_MS=60000

# Optional: status server port (default: 3001)
STATUS_PORT=3001
